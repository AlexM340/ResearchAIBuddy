# CerebrumAI — exemplu de secrete pentru Streamlit Community Cloud (valori FICTIVE).
#
# Aplicatia citeste secretele prin os.getenv (NU prin st.secrets). Streamlit
# expune cheile TOP-LEVEL din acest fisier ca variabile de mediu, deci pastreaza-le
# la nivel top-level (fara sectiuni [..]) ca os.getenv sa le vada.
#
# In Streamlit Community Cloud: Settings -> Secrets -> lipeste continutul de mai jos
# (cu valorile tale reale). NU comite un secrets.toml real in git.

# --- Gemini (OBLIGATORIU) ---
GOOGLE_API_KEY = "your_gemini_api_key"

# --- Supabase PostgreSQL + pgvector ---
POSTGRES_DSN = "postgresql://user:password@host:6543/postgres?sslmode=require"

# --- Neo4j AuraDB (optional) ---
NEO4J_URI = "neo4j+s://example.databases.neo4j.io"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "example_password"

# --- Tavily (optional) ---
TAVILY_API_KEY = "your_tavily_api_key"
