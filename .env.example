# CerebrumAI — exemplu de variabile de mediu (valori FICTIVE).
# Copiaza acest fisier in `.env` si completeaza cu valorile tale.
# NU comite niciodata `.env` cu valori reale (este in .gitignore).
#
# Numele variabilelor corespund exact celor citite de cod prin os.getenv
# (vezi src/main_flash.py:176-181,400 si docs/chapter7/environment_variables.md).

# --- Gemini (OBLIGATORIU) ---
GOOGLE_API_KEY=your_gemini_api_key

# --- Supabase PostgreSQL + pgvector (recomandat pentru Second Brain complet) ---
# Recomandat: connection pooler Supabase (port 6543, mod tranzactie) + SSL.
POSTGRES_DSN=postgresql://user:password@host:6543/postgres?sslmode=require

# --- Neo4j AuraDB (optional, pentru graful de cunostinte) ---
NEO4J_URI=neo4j+s://example.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=example_password

# --- Tavily (optional, pentru web search) ---
TAVILY_API_KEY=your_tavily_api_key
