{
    "gemini_api_key": "",
    "openai_api_key": "",
    "tavily_api_key": "",
    "wandb_api_key": "",
    "models": {
        "primary_llm": "gemini-2.5-flash",
        "fallback_llm": "gemini-2.0-flash-exp",
        "local_llm": "llama3:instruct",
        "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
        "evaluation_model": "gemini-2.5-flash"
    },
    "gemini": {
        "temperature": 0.1,
        "max_tokens": 65536,
        "rate_limits": {
            "requests_per_minute": 30,
            "requests_per_day": 3000
        }
    },
    "vector_db": {
        "type": "faiss",
        "index_path": "./data/cache/vector_index"
    },
    "chunking": {
        "chunk_size": 1000,
        "chunk_overlap": 200,
        "use_semantic_chunking": true,
        "max_context_docs": 5
    },
    "rag": {
        "retrieval_candidates": 20,
        "rerank_top_k": 8,
        "neighbor_window": 1,
        "hybrid_alpha": 0.7,
        "use_hybrid_search": true,
        "use_reranking": true,
        "compression_enabled": true,
        "use_cache": true
    },
    "storage": {
        "postgres_dsn": "",
        "pgvector_embedding_dim": 384
    },
    "graph": {
        "neo4j_uri": "neo4j+s://b42979c2.databases.neo4j.io",
        "neo4j_user": "neo4j",
        "neo4j_password": ""
    },
    "retrieval_quality": {
        "enable_reranker": true,
        "reranker_model": "cross-encoder/mmarco-mMiniLMv2-L12-H384-v1",
        "reranker_input_k": 20,
        "enable_hyde": false,
        "hyde_max_tokens": 200
    },
    "web_search": {
        "enable_web_fallback": true,
        "max_results": 5,
        "search_depth": "advanced"
    },
    "second_brain": {
        "enable_graph_rag": true,
        "router_mode": "rule_based",
        "vector_confidence_threshold": 0.35,
        "context_budget_tokens": 8000,
        "vector_budget_ratio": 0.65,
        "graph_budget_ratio": 0.35,
        "decision_extraction_enabled": true,
        "graph_max_hops": 2,
        "graph_min_confidence": 0.7,
        "graph_extraction_mode": "heuristic_fallback",
        "memory_consolidation_enabled": true,
        "memory_decay_days": 90,
        "db_primary_strict": true,
        "ingestion_embedding_batch_size": 64,
        "ingestion_max_workers": 4
    },
    "retrieval": {
        "vector_top_k": 8,
        "graph_top_k_paths": 6,
        "hybrid_rerank_top_k": 8
    },
    "agent": {
        "max_iterations": 10,
        "enable_reflection": true,
        "enable_planning": true,
        "enable_tools": true
    },
    "evaluation": {
        "use_ai_judge": true,
        "metrics": ["faithfulness", "relevance", "coherence"]
    },
    "ui": {
        "title": "APCI - Asistentul Personalizat de Cercetare și Învățare",
        "theme": "dark",
        "sidebar_width": 300
    },
    "features": {
        "multimodal": false,
        "web_search": false,
        "auto_save": true,
        "export_formats": ["txt", "md", "pdf"]
    }
}
